# Copy sang .env rồi chỉnh (local dev)

# --- Bắt buộc ---
# Local: dùng Postgres qua Docker (npm run db:up)
DATABASE_URL="postgresql://blooming:blooming@localhost:5433/blooming?schema=public"
# Production: chuỗi kết nối Postgres cloud (Neon / Supabase / Vercel Postgres)

# Khoá ký session cookie — production PHẢI đổi, tạo bằng: openssl rand -base64 32
AUTH_SECRET="dev-only-secret-change-me-please-32chars-min"

# --- Public site config ---
NEXT_PUBLIC_SITE_NAME="blooming."
NEXT_PUBLIC_DEFAULT_LOCALE="vi"

# --- Tùy chọn ---
# Lưu ảnh admin upload lên Vercel Blob (chỉ cần trên production).
# Không đặt -> ảnh ghi vào /public/uploads (chỉ hợp local dev).
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"
